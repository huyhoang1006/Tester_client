{
  "_doc": [
    "Map OMICRON CPXpert Transformer tests to the existing Transformer tests.",
    "Calculated/reference fields are not sourced from CPXpert unless the client already stores them as test results.",
    "Explicit PTM Pass/Fail results are preserved; unassessed or indeterminate results remain blank."
  ],
  "SFRA": {
    "ptmType": "FRATest",
    "columns": {
      "output_voltage": { "from": "outputVoltage", "factor": 1 }
    },
    "plainColumns": {
      "trace_name": { "from": "name" },
      "group_name": { "from": "groupName" },
      "source_standard": { "from": "sourceStandard" },
      "reference_terminal": { "from": "referenceTerminal" },
      "response_terminal": { "from": "responseTerminal" },
      "measured_date": { "from": "measuredDate" },
      "tap_position": { "from": "tapPosition" },
      "shorted_terminals": { "from": "shortedTerminals" },
      "grounded_terminals": { "from": "groundedTerminals" },
      "trace_color": { "from": "color" },
      "source_file": { "from": "sourceFile" },
      "points_json": { "from": "points", "serialize": "json" }
    }
  },
  "RatioPrimSec": {
    "ptmType": "TransformerRatioTest",
    "columns": {
      "tap": { "from": "tap", "factor": 1 },
      "voltage_prim": { "from": "voltagePrimary", "factor": 0.001 },
      "voltage_sec": { "from": "voltageSecondary", "factor": 0.001 },
      "i_out": { "from": "currentOut", "factor": 1000 },
      "nominal_ratio": { "from": "nominalRatio", "factor": 1 },
      "ratio_meas": { "from": "measuredRatio", "factor": 1 },
      "ratio_dev": { "from": "ratioDeviation", "factor": 1 }
    },
    "plainColumns": {
      "phase": { "from": "phase" }
    },
    "assessment": {
      "from": "assessment",
      "map": { "Pass": "Pass", "Passed": "Pass", "ManualPass": "Pass", "Fail": "Fail", "Failed": "Fail", "ManualFail": "Fail", "None": "", "NotPossible": "", "Investigate": "", "": "" }
    }
  },
  "WindingDfCap": {
    "ptmType": "TanDeltaTest",
    "ptmName": "Winding DF & CAP",
    "columns": {
      "test_voltage": { "from": "testVoltage", "factor": 0.001 },
      "frequency": { "from": "frequency", "factor": 1 },
      "df_ref": { "from": "powerFactorReference", "factor": 1 },
      "c_ref": { "from": "capacitanceReference", "factor": 1000000000000 },
      "df_meas": { "from": "powerFactorMeasured", "factor": 1 },
      "c_meas": { "from": "capacitanceMeasured", "factor": 1000000000000 }
    },
    "plainColumns": {
      "measurement": { "from": "baseMeasurement" },
      "test_mode": { "from": "testMode" }
    },
    "assessment": {
      "from": "assessment",
      "map": { "Pass": "Pass", "Passed": "Pass", "ManualPass": "Pass", "Fail": "Fail", "Failed": "Fail", "ManualFail": "Fail", "Investigate": "", "NotPossible": "", "None": "", "": "" }
    }
  },
