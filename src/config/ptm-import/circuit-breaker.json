{
  "_doc": [
    "Map OMICRON CIBANO PTM tests to Circuit Breaker tests in the client.",
    "Only test types listed here are imported. Adding a verified test mapper makes it",
    "appear automatically in the existing PTM preview and merge workflow."
  ],
  "GeneralInspection": {
    "ptmType": "GeneralInspectionTest",
    "ptmName": "General inspection",
    "columns": {}
  },
  "ContactResistance": {
    "ptmType": "ContactResistanceTest",
    "ptmName": "Contact resistance",
    "columns": {
      "phase": { "from": "phase", "kind": "scalar" },
      "interrupter": { "from": "interrupter", "kind": "scalar" },
      "i_test": { "from": "measuredCurrentDc", "factor": 1 },
      "contact_resistance": { "from": "measuredResistance", "factor": 1000000 }
    },
    "assessment": {
      "from": "assessment",
      "to": "assessment",
      "map": {
        "Pass": "",
        "Passed": "",
        "Acceptable": "",
        "Fail": "Fail",
        "Failed": "Fail",
        "NotAcceptable": "Fail",
        "None": "",
        "Empty": "",
        "Unknown": ""
      }
    }
  },
  "ODynamicContactResistance": {
    "ptmType": "DynamicContactResistanceTest",
    "ptmName": "O Dynamic Contact Resistance",
    "columns": {
      "phase": { "from": "phase", "kind": "scalar" },
      "interrupter": { "from": "interrupter", "kind": "scalar" },
      "i_test": { "from": "testCurrent", "factor": 1 },
      "opening_time": { "from": "openingTime", "factor": 1000 }
    },
    "assessment": {
      "from": "assessment",
      "to": "assessment",
      "map": {
        "Pass": "",
        "Passed": "",
        "Acceptable": "",
        "Fail": "Fail",
        "Failed": "Fail",
        "NotAcceptable": "Fail",
        "None": "",
        "Empty": "",
        "Unknown": ""
      }
    },
    "timingTraces": { "from": "timingTraces" }
  },
